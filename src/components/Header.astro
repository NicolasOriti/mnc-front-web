---
type Props = {
  loginUrl?: string;
};

const { loginUrl } = Astro.props;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="MyNutriCoach, inicio">
    <img src="/brand/logo.png" alt="MyNutriCoach" />
  </a>
  <nav aria-label="Navegación principal">
    <a href="#consulta">Solicitar una consulta</a>
    {loginUrl && <a class="login" href={loginUrl}>Ingresar</a>}
  </nav>
</header>
